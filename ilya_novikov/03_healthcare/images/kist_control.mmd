%% КИСТЬ-М: контур момента и режимы
flowchart TD
    P[Программа врача: угол, скорость, режим, повторы] --> S[Контроллер STM32F405]
    T[Тензодатчик натяжения 0-10 кг, 500 Гц] --> F{момент > 4 Н·м?}
    F -- да --> STOP[Аппаратный стоп привода — предохранитель]
    F -- нет --> S
    I[ИМС запястья: активная попытка движения] --> M[Выбор режима]
    M --> R1[Пассивный: движение по программе 0-60°/с]
    M --> R2[Ассистивный: помощь при слабости пациента]
    M --> R3[Резистивный: сопротивление с настройкой момента]
    M --> R4[Игровой: задания с обратной связью]
    R1 --> A[Привод пальцев, сухожильная передача]
    R2 --> A
    R3 --> A
    R4 --> A
    A --> L[Журнал сеанса: углы, моменты, повторы]
    L --> APP[Приложение врача: динамика, назначения]
