%% БОРА-5: силовая цепь установки
flowchart LR
    W[Ветер: средняя 6,8 м/с + бора до 60 м/с] --> R[Ротор Дарье-Савониус, 2,5×3,0 м, 180 кг]
    R --> L[Магнитный подвес: нижнее кольцо несёт 240 кг, верхнее центрирует, зазор 2,0±0,3 мм]
    R --> G[Генератор аксиальный, 24 полюса, прямой привод]
    G --> C[Контроллер: трекер мощности до 15 м/с]
    C -- до 25 м/с --> B[Аккумулятор / сеть объекта, 48 В]
    C -- свыше 25 м/с --> H[Штормовой сброс: ТЭН-балласт 5 кВт -> ГВС объекта]
    S[Датчики Холла, зазор подвеса] --> C
    A[Анемометр на высоте ротора] --> C
    T[LTE-телеметрия: журнал эпизодов боры] --> C
