%% ПРОФИЛЬ-ТР: путь данных
flowchart LR
    L[Лазерный дальномер 100 Гц, пятно 6 мм] --> F[Фильтр Калмана: вычитание колебаний прицепа]
    I[МЭМС акселерометр + гироскоп] --> F
    G[ГЛОНАСС с поправками: пикетаж и координаты] --> P[Реконструкция продольного профиля]
    F --> P
    P --> IRI[Расчёт IRI, модель четверть автомобиля, ГОСТ 33180]
    P --> D[Детектор дефектов: провал/волна 0,5-30 м]
    P --> R[Колейность по лазерным точкам]
    IRI --> PASS[Паспорт участка: профиль + оценка принять/гарантия]
    D --> PASS
    R --> PASS
    PASS --> GIS[Выгрузка в ГИС района]
    PASS --> A[Акт приёмки / гарантийное требование подрядчику]
