%% АГРОСПЕКТР-К: архитектура обработки данных
flowchart LR
    A[Трактор + штанга 4 м] --> B1[RGB-камера 12 Мп]
    A --> B2[Канал 550 нм]
    A --> B3[Канал 680 нм]
    A --> B4[Канал 760 нм]
    A --> B5[Канал 850 нм]
    B1 --> C[Контроллер синхронизации STM32F405]
    B2 --> C
    B3 --> C
    B4 --> C
    B5 --> C
    C --> D[Jetson Orin Nano 8 ГБ]
    G[GNSS u-blox ZED-F9P, 2 см] --> D
    D --> E[Индексы: NDVI, NDRE, PRI, флуоресценция]
    E --> F[CNN MobileNetV3-Small, INT8, 38 мс/кадр]
    F --> H{P класса >= 0.75?}
    H -- нет --> I[В архив наблюдений]
    H -- да --> J{Подтверждено во 2-й съёмке через 5-7 сут?}
    J -- нет --> I
    J -- да --> K[Очаг: координаты + класс + стадия]
    K --> L[Карта-задание для опрыскивателя]
    L --> M[Адресная обработка очага]
    K --> N[Отчёт агроному, LTE/LoRa]
