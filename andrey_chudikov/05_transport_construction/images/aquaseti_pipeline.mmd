%% АКУСТИК-СЕТИ: контур обработки данных
flowchart TD
    P[Трубопровод, узлы на задвижках и гидрантах, шаг 150-250 м] --> N1[Узел 1: пьезодатчик + БПФ, запись 02:00-04:00]
    P --> N2[Узел 2]
    P --> N3[Узел N]
    N1 -- NB-IoT --> S[Сервер корреляции]
    N2 -- NB-IoT --> S
    N3 -- NB-IoT --> S
    S --> C[Парная кросс-корреляция соседних записей]
    C --> V[Адаптивная скорость волны: сталь 1200 м/с, чугун ~950 м/с]
    V --> L[L = D − v·τ / 2 — расстояние до источника]
    L --> B[Байесовская вероятность утечки на участке]
    B --> A{P >= 0,75 два окна подряд?}
    A -- да --> T[Тревога диспетчеру: координата + расчётный дебит]
    A -- нет --> R[В архив наблюдений]
    T --> F[Шурфовка / ремонт]
    F --> FB[Актуализация паспортов участков -> перекалибровка скоростей]
